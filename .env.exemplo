# Copie este arquivo para ".env" e ajuste. O .env NAO vai para o GitHub.

# Qual IA usar para layouts desconhecidos: ollama | gemini | nenhuma
IA_PROVEDOR=ollama

# --- Ollama (gratis, roda no seu computador) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:3b

# --- Gemini (camada gratuita do Google AI Studio) ---
# Crie a chave em https://aistudio.google.com/apikey
# "...-latest" sempre aponta para o modelo mais novo (os nomes
# com versao, ex. gemini-2.5-flash, sao aposentados com o tempo).
# No plano gratis o "gemini-flash-latest" (mais esperto) vive sobrecarregado
# (erro 503); o "lite" costuma responder na hora.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-lite-latest

# Tempo maximo de espera pela IA, em segundos
# IA_TIMEOUT=900

# Quantas vezes a IA pode corrigir a resposta quando a conferencia reprova
# IA_CORRECOES=2

# Quantas vezes tentar de novo quando o servidor esta ocupado (erro 429/503)
# IA_TENTATIVAS_REDE=4
